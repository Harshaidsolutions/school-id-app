{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@admin/*": [
        "../admin-web/src/*"
      ],
      "@gen/*": [
        "../admin-web/src/generator/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ]
    }
  },
  "include": [
    "renderer"
  ]
}