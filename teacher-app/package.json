{
  "name": "teacher-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-telugu": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "axios": "^1.18.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vision-camera": "^5.2.0",
    "react-native-vision-camera-face-detector": "^2.0.6"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vision-camera.js && node scripts/patch-notification-image.js",
    "start": "expo start",
    "start:go": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev:android": "eas build --profile development --platform android",
    "assets:generate": "node scripts/generate-icon-assets.mjs",
    "assets:logos": "node scripts/build-header-logo.mjs && node scripts/sync-in-app-logos.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "android:network": "node scripts/ensure-android-release-network.mjs",
    "prebuild:release": "npm run assets:generate && npm run assets:logos && npm run assets:verify && npm run android:network"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      }
    }
  }
}
