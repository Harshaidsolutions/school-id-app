# Teacher app talks to the SAME backend that hosts the admin web panel.
# Origin only — no /api suffix (the client appends /api).
#
# Production admin API (HTTPS). Do not use the raw EC2 IP; /api there returns 404.
EXPO_PUBLIC_API_URL=https://myschoolidcard.in
#
# Local LAN (phone + PC on same Wi-Fi, backend on :5000):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:5000
