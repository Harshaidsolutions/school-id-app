# Required
DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@harsha-id-db.XXXX.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require
JWT_SECRET=generate_a_long_random_secret

# AWS S3 (photo / PDF / template storage)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
S3_BUCKET_NAME=harsha-id-storage
# Optional CloudFront (or custom domain) base — no trailing slash
# S3_PUBLIC_BASE_URL=https://d111111abcdef8.cloudfront.net

# One-time: copy existing public photo URLs → S3
#   npm run migrate:photos-to-s3 --prefix backend -- --dry-run
#   npm run migrate:photos-to-s3 --prefix backend

# One-time: Supabase Postgres → RDS (set SOURCE + TARGET; SOURCE defaults to DATABASE_URL)
#   $env:SOURCE_DATABASE_URL="postgresql://...supabase..."
#   $env:TARGET_DATABASE_URL="postgresql://...rds..."
#   npm run migrate:supabase-to-rds --prefix backend
#   npm run verify:db-counts --prefix backend

# Set by Railway automatically; optional override
PORT=5000
NODE_ENV=production

# CORS — comma-separated origins for the teacher app (and any other clients).
# Admin is same-origin so it does not need an entry.

# Optional photo cleanup cron (default: daily 02:00 server time)
# PHOTO_CLEANUP_CRON=0 2 * * *

# Amazon SNS Mobile Push (Teacher App Android system notifications)
# Create an SNS Platform Application (Firebase Cloud Messaging) in AWS Console,
# then paste the Platform Application ARN here. FCM server key / service account
# is configured only in SNS — not in the mobile app.
# SNS_ANDROID_PLATFORM_ARN=arn:aws:sns:ap-south-1:123456789012:app/GCM/harsha-teacher-android

# WhatsApp Cloud API — Get in Touch delivers only after WhatsApp accepts the message.
# The visitor is not redirected. Leave unset until a token exists; do not invent values.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO=917799881779

# SMTP for password-reset OTPs (required in production)
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM="Harsha ID Solutions <noreply@yourdomain.com>"
