{
  "name": "admin-web",
  "private": true,
  "version": "1.0.0",
  "description": "Admin panel + API (backend in ./backend)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "install:all": "npm install --include=dev && npm install --include=dev --prefix backend",
    "build:admin": "npm run build && node scripts/copy-admin-to-public.js",
    "build:backend": "npm run build --prefix backend",
    "build:all": "npm run build:admin && npm run build:backend",
    "migrate": "npm run migrate --prefix backend",
    "start": "npm run migrate --prefix backend && npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
